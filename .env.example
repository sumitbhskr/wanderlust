# MongoDB Atlas Connection String (Required for Vercel)
ATLASDB_URL=your_mongodb_atlas_connection_string_here

# Cloudinary Configuration (Required)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Session Secret (Optional - defaults to a hardcoded value in development)
SESSION_SECRET=your_random_secret_string_here

# Port (Optional - Vercel will set this automatically)
PORT=8080
