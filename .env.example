# MongoDB Atlas Connection String
# Get this from your MongoDB Atlas cluster
# Format: mongodb+srv://username:password@cluster.mongodb.net/wanderlust?retryWrites=true&w=majority
# You can use either variable name:
MONGODB_URI=your_mongodb_atlas_connection_string_here
# OR
# ATLASDB_URL=your_mongodb_atlas_connection_string_here

# Session Secret (use a strong random string in production)
SECRET=your_secret_key_here
